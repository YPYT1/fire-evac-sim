{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint --ext .ts,.tsx,.vue src",
    "lint:fix": "ESLINT_USE_FLAT_CONFIG=false eslint --ext .ts,.tsx,.vue src --fix",
    "format": "prettier --check \"src/**/*.{ts,tsx,vue,js,json,css,scss}\"",
    "format:fix": "prettier --write \"src/**/*.{ts,tsx,vue,js,json,css,scss}\"",
    "test:unit": "vitest",
    "test:unit:run": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@playwright/test": "^1.56.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/vue": "^8.1.0",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "9",
    "jsdom": "^27.0.1",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "vite": "^7.1.7",
    "vitest": "^4.0.3"
  },
  "dependencies": {
    "@types/three": "^0.180.0",
    "pinia": "^3.0.3",
    "three": "^0.180.0",
    "three-nebula": "^10.0.3",
    "vue": "^3.5.22",
    "vue-router": "^4.6.3"
  }
}
